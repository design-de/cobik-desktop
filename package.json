{
  "name": "cobik-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cobik Desktop — cobik ทางซ้าย Claude ทางขวา",
  "author": "Bluebik Design Engineering",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "COBIK_TARGET=local electron .",
    "skills": "node scripts/sync-skills.mjs",
    "icon": "env -u ELECTRON_RUN_AS_NODE electron scripts/make-icon.mjs",
    "dist": "npm run skills && npm run icon && env -u ELECTRON_RUN_AS_NODE electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.274"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.bluebik.cobik.desktop",
    "productName": "Cobik",
    "copyright": "Bluebik",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "skills-plugin/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "LSMinimumSystemVersion": "12.0"
      }
    },
    "dmg": {
      "title": "Cobik",
      "artifactName": "Cobik-${version}-arm64.dmg"
    }
  }
}
